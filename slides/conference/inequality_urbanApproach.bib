@article{HuYueXingYiFei2026,
  title = {双向认知视角下新老市民群体的身份建构与行为治理研究},
  author = {{胡悦} and {邢羿飞}},
  date = {2026},
  journaltitle = {华中科技大学学报（社会科学版）},
  volume = {40},
  number = {4},
  pages = {63--73},
  doi = {10.19648/j.cnki.jhustss1980.2026.04.07},
  urldate = {2026-08-15},
  abstract = {新型城镇化背景下，新老市民的身份认知问题已成为城市治理研究中的重要议题。本研究从双向认知的视角出发，基于2021---2022年``中国社会价值观调查''中的两项实验数据，系统考察城市化进程中新老市民的身份冲突及其行为影响。研究发现：第一，新市民群体已基本完成身份融入，在身份认知上更倾向于将自身与老市民视为同一群体；而老市民仍倾向于认为新市民在先赋特征和社会地位等方面劣于本地居民，形成了``老市民凝视''现象。第二，``老市民凝视''不仅降低老市民对本地人才政策的支持度和期望子女留居本地的意愿，也会削弱新市民期望子女继续留居本地的意愿，这表明新老市民的身份认知冲突具有显著的行为外溢效应。第三，上述效应在不同类型城市和年龄群体中均有存在，且在人口流入比例较低地区表现得更为明显。这表明``老市民凝视''具有普遍性，并不会随着居住地变化或代际更替而自然消解。},
  langid = {chinese},
  file = {D:\zotero_system\storage\K79GX499\ 胡悦邢羿飞2026_双向认知视角下新老市民群体的身份建构与行为治理研究.pdf}
}

@article{WangXiangHuYue2026,
  title = {约束与包容:流动人口司法治理的差异性研究},
  shorttitle = {约束与包容},
  author = {{王翔} and {胡悦}},
  date = {2026-01-29},
  journaltitle = {公共管理评论},
  pages = {1--26},
  issn = {2096-7713},
  urldate = {2026-01-30},
  abstract = {对流动人口犯罪依法进行审判,是司法参与社会治理的重要方式,亦是保障流动人口有序治理的重要防线。本文聚焦流动人口司法裁判问题,基于164790份裁判文书数据展开系统分析,从裁判差异角度实证考察司法对流动人口犯罪的治理策略与运作机制。研究发现,流动人口犯罪司法治理呈现出约束效应和包容效应并存的双重倾向:相较于本地人口犯罪,司法对流动人口犯罪判决刑期量刑更严,约束性更强;但同时,司法判决又受当地经济和文化两大维度影响,对司法约束性形成非线性调节。两种效应共同塑造了流动人口司法治理力度,为规范流动人口有序发展构建了法治化空间。准确把握这两种司法效应,有助于为完善我国流动人口犯罪防控体系提供更为坚实的经验支撑。},
  langid = {chinese},
  file = {D:\zotero_system\storage\5BQPLPCX\ 王翔胡悦2026_约束与包容流动人口司法治理的差异性研究.pdf}
}

