  title = {“It’s like Night and Day”: How Bureaucratic Encounters Vary across {{WIC}}, {{SNAP}}, and Medicaid},
  shorttitle = {“It’s like Night and Day”},
  author = {Barnes, Carolyn and Michener, Jamila and Rains, Emily},
  date = {2023-03},
  journaltitle = {Social Service Review},
  shortjournal = {Soc. Serv. Rev.},
  volume = {97},
