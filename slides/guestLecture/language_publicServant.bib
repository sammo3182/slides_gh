  doi = {10.1146/annurev-polisci-060415-093825},
  url = {https://www.annualreviews.org/content/journals/10.1146/annurev-polisci-060415-093825},
  urldate = {2024-10-20},
  abstract = {Against the backdrop of Ferguson and the Black Lives Matter movement, we ask what the American politics subfield has to say about the political lives of communities subjugated by race and class. We argue that mainstream research in this subfield—framed by images of representative democracy and Marshallian citizenship—has provided a rich portrait of what such communities lack in political life. Indeed, by focusing so effectively on their political marginalization, political scientists have ironically made such communities marginal to the subfield\&apos;s account of American democracy and citizenship. In this article, we provide a corrective by focusing on what is present in the political lives of such communities. To redress the current imbalance and advance the understandings of race and class in American politics, we argue that studies of the liberal-democratic “first face” of the state must be complemented by greater attention to the state\&apos;s more controlling “second face.” Focusing on policing, we seek to unsettle the mainstream of a subfield that rarely inquires into governmental practices of social control and the ways “race-class subjugated communities” are governed through coercion, containment, repression, surveillance, regulation, predation, discipline, and violence.},
  issue = {Volume 20, 2017},
  langid = {english},
  file = {/Users/shafan/Zotero/storage/I6ADR8MQ/Soss和Weaver - 2017 - Police are our government politics, political science, and the policing of race–class subjugated co.pdf;/Users/shafan/Zotero/storage/6ADZG87C/annurev-polisci-060415-093825.html}
}

