@article{WangQianEtAl2024,
  title = {热搜代表民意？大众媒体对热点算法的合法性话语建构},
  author = {{王茜} and {孟志杰} and {张璐}},
  date = {2024},
  journaltitle = {国际新闻界},
  shortjournal = {国际新闻界},
  volume = {46},
  number = {3},
  pages = {95--115},
  issn = {1002-5685},
  doi = {10.13495/j.cnki.cjjc.2024.03.003},
  url = {https://kns.cnki.net/KCMS/detail/detail.aspx?dbcode=CJFQ&dbname=CJFDLAST2024&filename=GJXW202403005},
  urldate = {2025-03-03},
  abstract = {以往，大众媒体主要通过民意调查来量化民意；如今，微博热搜日益被视为民意的风向标。本文应用民意基础设施模型，采用文本分析、访谈和内容分析法，考察热搜定义和测量民意的方式，以及大众媒体如何看待和阐释热搜。研究发现，随着2018年上榜规则的调整，热搜糅合了“个体的搜索痕迹聚合”和“公众之间的互动和交流”，前者是个体的、私下的、平等的，后者是关系的、公开的、分层级的，标志着“一人一票”逻辑向“优先考虑明智舆论”的转变。媒体将热搜描绘为民意的代名词，常使用“冲上热搜”“热搜第一”作为评估公众反应的基准，进而合法化了热点算法的知识逻辑。该发现有助于修正“党媒对算法持批判态度”的结论，未来研究可纳入更多“人与算法相遇”的具体场景。},
