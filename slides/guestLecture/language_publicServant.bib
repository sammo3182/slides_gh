@article{wuOutsidersMediaHow2026,
  title = {Outsiders in the Media: How a Sense of “Foreignness” Shapes Support for Censorship in {{China}}},
  shorttitle = {Outsiders in the Media},
  author = {Wu, Ziyi},
  date = {2026-01-02},
  journaltitle = {Political Communication},
  shortjournal = {Polit. Commun.},
  volume = {43},
  number = {1},
  pages = {65--88},
  publisher = {Routledge},
  issn = {1058-4609},
  doi = {10.1080/10584609.2025.2529926},
  url = {https://doi.org/10.1080/10584609.2025.2529926},
  urldate = {2026-03-16},
  abstract = {This paper investigates how a historical “us versus them” mentality fuels Chinese citizens’ support for government censorship. Cues of foreignness foster alienation from the sender and support for censorship by signaling that the message comes from out-group deviants. I conducted online survey experiments and found that explicit cues (IP addresses) significantly boost support for censorship, while implicit cues (language) have a weaker effect. Both types of cues make respondents more likely to label the sender a foreigner or a Chinese national prone to foreign manipulation. Study participants with stronger nationalist sentiments and system justification tendencies were more responsive to both cues, whereas pro-Western-democracy attitudes only mitigated the impact of foreign languages. I observed these moderation effects primarily for less politically sensitive topics.},
  langid = {english},
  keywords = {authoritarianism,censorship,China,social identity theory},
  file = {/Users/shafan/Zotero/storage/KFJIHTWS/Wu - 2026 - Outsiders in the media how a sense of “foreignness” shapes support for censorship in China.pdf}
}

