@article{Ma2012,
  title = {The Rise of Social Accountability in China},
  author = {Ma, Jun},
  date = {2012},
  journaltitle = {Australian Journal of Public Administration},
  shortjournal = {Aust. J. Public Adm.},
  volume = {71},
  number = {2},
  pages = {111--121},
  issn = {1467-8500},
  doi = {10.1111/j.1467-8500.2012.00770.x},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/j.1467-8500.2012.00770.x},
  urldate = {2025-04-03},
  abstract = {The development of Chinese social accountability illustrates that society itself is a powerful force for enhancing accountability. It can enable a form of societal control of the government in a non-electoral regime. However, the absence of competitive election has limited the development of social accountability in China. The Chinese case nevertheless helps improve our understanding of the role of society in accountability building. 长期以来，关于社会问责的讨论都局限在实行选举民主的国家。最近十来年，社会问责开始在中国兴起。这主要是因为，经过三十多年的经济体制改革，中国社会也发生巨大的变化。公民社会正在形成之中，要求建立一个负责的政府的呼声也越来越强烈。在这个背景下，正在形成中的公民社会开始发展成为一个推动政治问责的重要力量，各种形式的社会问责开始出现。随着社会问责的兴起，尽管中国仍然是一个非竞争性选举的国家，一种对政府的社会控制开始发展起来。这表明，“没有选举的问责”是可能的。然而，缺乏竞争性的选举也同时制约着社会问责在中国的发展。例如，绝大部分社会问责形式都缺乏制度化或者制度化程度比较低。尽管如此，中国的例子仍然有助于我们理解公民社会在问责机制建设中发挥的作用，也有助于我们理解政治问责在非西方世界的复杂性。},
  langid = {chinese},
  file = {/Users/shafan/Zotero/storage/8TLALDDH/Ma (马骏) - 2012 - The Rise of Social Accountability in China (社会问责在中国的兴起).pdf;/Users/shafan/Zotero/storage/MPEATPEU/Ma (马骏) - 2012 - The Rise of Social Accountability in China (社会问责在中国的兴起).pdf;/Users/shafan/Zotero/storage/CPH84MSZ/j.1467-8500.2012.00770.html}
}

@article{Mahoney2012,
  title = {The Logic of Process Tracing Tests in the Social Sciences},
  author = {Mahoney, James},
  date = {2012-11-01},
  journaltitle = {Sociological Methods \& Research},
  shortjournal = {Sociol. Methods Res.},
  volume = {41},
  number = {4},
  pages = {570--597},
  publisher = {SAGE Publications Inc},
  issn = {0049-1241},
  doi = {10.1177/0049124112437709},
  url = {https://doi.org/10.1177/0049124112437709},
  urldate = {2024-11-07},
  abstract = {This article discusses process tracing as a methodology for testing hypotheses in the social sciences. With process tracing tests, the analyst combines preexisting generalizations with specific observations from within a single case to make causal inferences about that case. Process tracing tests can be used to help establish that (1) an initial event or process took place, (2) a subsequent outcome also occurred, and (3) the former was a cause of the latter. The article focuses on the logic of different process tracing tests, including hoop tests, smoking gun tests, and straw in the wind tests. New criteria for judging the strength of these tests are developed using ideas concerning the relative importance of necessary and sufficient conditions. Similarities and differences between process tracing and the deductive-nomological model of explanation are explored.},
  langid = {english},
  file = {/Users/shafan/Zotero/storage/L99N7VT3/Mahoney - 2012 - The logic of process tracing tests in the social sciences.pdf}
}

