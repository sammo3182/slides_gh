@article{WangQuanWei2023,
  title = {统治风险与胥吏人事：官吏分途现象形成与持续的政治逻辑分析},
  author = {{王泉伟}},
  date = {2023},
  journaltitle = {社会},
  volume = {43},
  number = {4},
  pages = {214--239},
  issn = {1004-8804},
  doi = {10.15992/j.cnki.31-1123/c.2023.04.004},
  url = {https://kns.cnki.net/kcms2/article/abstract?v=0kbmF0AymBBPJZrK2UFfqstZm1drAGowp7l7X2GUZYgz4BeVYxwsx4uozZ0dXF233xHN6xjbWkzE9U6vMyHfCtq1HONhdtG3fgoVxAFBFbSS7Lese2z0VJF-cWPkeJdIxn-0N_7GUzZPf8OW0jdaQA==&uniplatform=NZKPT&language=CHS},
  urldate = {2023-12-12},
  abstract = {本文试图论证，官吏分途从治理逻辑来看是一个非常糟糕的制度安排，其形成与持续主要是政治逻辑支配的结果。古代中国一直存在着朋党与官僚贵族化等官僚人事风险，导致统治者的人事权力受到侵蚀，危及统治基础。胥吏人事制度涉及各级政府如何安排僚属的问题，因而与上述官僚人事风险紧密关联。文章认为，官吏分途的形成是东汉以来官僚贵族化的结果，贵族与庶族的社会身份差异影响了正式官制的设置，造成官与吏在来源人群、等级地位与道德评价上的全面分途。官吏分途的持续则与后世统治者对官僚人事风险的防范有关。胥吏人事的合理化需要重新引入政治上风险巨大的辟署制，统治者宁愿忍受官吏分途导致的治理弊病也不愿变革。本文的研究拓展了“风险论”的视野，揭示了此前较少为人关注的官僚人事风险及其对中国古代官僚体制的深远影响。值得注意的是，类似的统治风险在当代依然部分存在，也受到中央越来越多的关注重视，并着手防范整治。},
  langid = {chinese},
  file = {/Users/shafan/Zotero/storage/RQN5GU4N/王_2023_统治风险与胥吏人事：官吏分途现象形成与持续的政治逻辑分析.pdf}
}

@article{WangYaHuaXiaoYaZhou2022,
