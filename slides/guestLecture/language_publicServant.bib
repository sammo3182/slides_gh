@article{ChanSuizhou2007,
  title = {Civil {{Service Law}} in the {{People}}’s {{Republic}} of {{China}}: {{A Return}} to {{Cadre Personnel Management}}},
  shorttitle = {Civil {{Service Law}} in the {{People}}’s {{Republic}} of {{China}}},
  author = {Chan, Hon S. and Suizhou, Edward Li},
  date = {2007-05},
  journaltitle = {Public Administration Review},
  shortjournal = {Public Adm. Rev.},
  volume = {67},
  number = {3},
