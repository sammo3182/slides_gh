@article{haim2021,
  title = {Family Matters: The Double-Edged Sword of Police-Community Connections},
  shorttitle = {Family Matters},
  author = {Haim, Dotan and Nanes, Matthew and Davidson, Michael W.},
  date = {2021-10},
  journaltitle = {Journal of Politics},
  shortjournal = {J. Polit.},
  volume = {83},
  number = {4},
  pages = {1529--1544},
  publisher = {The University of Chicago Press},
  issn = {0022-3816},
  doi = {10.1086/715071},
  url = {https://www.journals.uchicago.edu/doi/10.1086/715071},
  urldate = {2024-10-08},
  abstract = {Scholars and policy makers frequently advocate recruiting “embedded” bureaucrats with strong ties to citizens in order to improve service delivery. Yet, officials who are too embedded in their communities are often blamed for corruption, favoritism, and ineffectiveness. We argue that this ambiguity stems from a mismatch between individual- and community-level effects of embeddedness. While personal ties increase engagement between directly connected citizens and bureaucrats, a community-level increase in bureaucrats’ personal ties alienates unconnected citizens and undermines claims of impartiality. We test this argument on public safety provision in the Philippines. We measure family networks in 286 villages, locate police officers within those networks, and analyze citizen survey responses. Citizens are more willing to trust and engage with officers to whom they are more closely related. However, in villages where officers are highly embedded, unconnected citizens evaluate their performance more poorly. Consequently, village-level officer embeddedness is associated with higher rates of feuds and disputes.},
  langid = {english},
  file = {/Users/shafan/Zotero/storage/KSTJLIDP/Haim 等 - 2021 - Family matters the double-edged sword of police-community connections.pdf}
}

