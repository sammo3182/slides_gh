@article{SimpserEtAl2018,
  title = {Dead but Not Gone: Contemporary Legacies of Communism, Imperialism, and Authoritarianism},
  shorttitle = {Dead but Not Gone},
  author = {Simpser, Alberto and Slater, Dan and Wittenberg, Jason},
  date = {2018-05-11},
  journaltitle = {Annual Review of Political Science},
  shortjournal = {Annu. Rev. Political Sci.},
  volume = {21},
  pages = {419--439},
  publisher = {Annual Reviews},
  issn = {1094-2939, 1545-1577},
  doi = {10.1146/annurev-polisci-062615-020900},
  url = {https://www.annualreviews.org/content/journals/10.1146/annurev-polisci-062615-020900},
  urldate = {2025-02-12},
  abstract = {A profusion of recent research has focused on historical legacies as key to understanding contemporary outcomes. We review this body of research, analyzing both the comparative-historical analysis (CHA) and modern political economy (MPE) research traditions as applied to the study of communism, imperialism, and authoritarianism. We restrict our focus to the sizeable subset of arguments that meets a relatively strict definition of legacies, i.e., arguments that locate the roots of present-day outcomes in causal factors operative during an extinct political order. For all their differences, the CHA and MPE approaches both face the challenges of convincingly identifying the sources of historical persistence and of reckoning with alternative channels of causation. We find that mechanisms of persistence in legacy research generally belong to one of three main categories. While both traditions acknowledge the role of institutions in historical persistence, CHA research tends to emphasize the lasting power of coalitions, whereas work in MPE often argues for the persistence of cognitions. We argue that, at their best, CHA and MPE approaches yield complementary insights. Further progress in legacy research will benefit from greater cross-fertilization across research traditions and deeper recognition of commonalities across communist, imperialist, and authoritarian regimes.},
  issue = {Volume 21, 2018},
  langid = {english},
  file = {/Users/shafan/Zotero/storage/9MCFQP33/Simpser 等 - 2018 - Dead but not gone contemporary legacies of communism, imperialism, and authoritarianism.pdf;/Users/shafan/Zotero/storage/NC4M8WRB/Simpser 等 - 2018 - Dead But Not Gone Contemporary Legacies of Commun.pdf;/Users/shafan/Zotero/storage/78P3PF7R/annurev-polisci-062615-020900.html}
}

@article{soss2017,
  title = {Police Are Our Government: Politics, Political Science, and the Policing of Race–Class Subjugated Communities},
